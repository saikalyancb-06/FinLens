# =============================================================================
# Application Configuration & Environment Variables
# =============================================================================

# Server Environment (development | production)
ENVIRONMENT=development

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_db

# Security & JWT Token Secrets
#
# The value below is a DEVELOPMENT PLACEHOLDER and app/config.py knows it by
# name: with ENVIRONMENT=production, validate_security() refuses to start the
# process while JWT_SECRET_KEY is unset or still equal to it. That check is the
# reason this line is safe to ship in an example file and fatal to ship in a
# deployment.
#
# For production, generate a real one and supply it through the environment —
# never through a file committed to the repository:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Rotating this invalidates every issued access and refresh token, so everyone
# signs in again. Plan it accordingly.
JWT_SECRET_KEY=dev-only-placeholder-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enable Demo Mode fixture fallbacks (true | false)
DEMO_MODE=false

# =============================================================================
# Microsoft 365 / Outlook Mailbox Connector (Multi-Tenant OAuth 2.0)
# =============================================================================

# Application (Client) ID from Microsoft Entra ID App Registration
MICROSOFT_CLIENT_ID=your-microsoft-client-id-here

# Client Secret Value from Microsoft Entra ID App Registration
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-here

# Tenant Authority ('common' for any multi-tenant work/school or personal account)
MICROSOFT_TENANT=common

# OAuth 2.0 Redirect URI (must match the Redirect URI in Entra ID App Registration)
MICROSOFT_REDIRECT_URI=http://localhost:8000/email/oauth/microsoft/callback

# =============================================================================
# Google / Gmail Mailbox Connector (OAuth 2.0)
# =============================================================================

# Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here

# Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth 2.0 Redirect URI (must match Authorized redirect URIs in Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/email/oauth/callback


# --- Cache -------------------------------------------------------------------
# OPTIONAL. The app runs correctly with no Redis at all: app/services/cache.py
# falls back to an in-process cache and logs that it has done so. Redis only
# adds sharing BETWEEN worker processes, which matters once you run more than
# one of them.
#
#   Local development
#         |
#         +-- REDIS_URL reachable  -> shared Redis
#         |
#         +-- no Redis             -> in-process fallback
#
#   Production
#         |
#         +-- REDIS_URL            -> hosted Redis (e.g. Upstash)
#
# Local container:
#   REDIS_URL=redis://localhost:6379/0
#
# Hosted (Upstash and most managed providers are TLS-only — note "rediss", with
# two s's; the URL from the console already has it):
#   REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
#
# Nothing else changes between the two. Keys are namespaced by ENVIRONMENT, so
# staging and production can safely share one hosted database.
REDIS_URL=redis://localhost:6379/0

# Force the in-process cache even where Redis is reachable. Useful when working
# out whether a stale figure came from the shared cache or the calculation
# behind it.
CACHE_REDIS_ENABLED=true

# Seconds to wait on a cache lookup before giving up and recomputing. Raise it
# if a distant hosted Redis makes the logs show the breaker opening.
CACHE_REDIS_TIMEOUT=1.0

# --- API documentation --------------------------------------------------------
# /docs, /redoc and /openapi.json. On by default outside production; OFF in
# production, because they publish the complete endpoint map and every request
# schema of a treasury system to unauthenticated callers. Set true to re-enable
# them in production deliberately — behind a private network, or while
# debugging an integration.
ENABLE_API_DOCS=false

# --- B2B Financial Analysis API (/v1) -----------------------------------------
# Guards /internal/clients (create API clients, issue/rotate/revoke keys).
# No default: unset or shorter than 16 chars => every admin call returns 503.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
B2B_ADMIN_TOKEN=
# Housekeeping loop: result retention purge, webhook retries, stuck requests.
B2B_MAINTENANCE_ENABLED=true
B2B_MAINTENANCE_INTERVAL_SECONDS=60
B2B_STUCK_REQUEST_MINUTES=30
# Per-IP limit applied to every route, /v1 included, BEFORE the per-client
# plan limits. Raise it if one integrator's plan allows more than this per
# minute from a single server IP.
RATE_LIMIT_PER_MINUTE=120
