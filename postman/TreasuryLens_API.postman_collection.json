          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/analyze",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "analyze"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick your statement file here"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('MISSING_API_KEY', () => pm.expect(pm.response.json().error.code).to.eql('MISSING_API_KEY'));"
                ]
              }
            }
          ]
        },
        {
