backend_sqlite.db

# ─── SQL backup snapshots ─────────────────────────────────────────────────────
*.sql
backup_*.sql

# ─── Uploads (user data / test debris) ───────────────────────────────────────
uploads/

# ─── CSV / data files (potentially large / sensitive) ────────────────────────
data.csv
data_combined.csv
data_original.csv
mlmodel/data.csv
mlmodel/golden_reference.csv

# ─── ML model artefacts (large binary files) ─────────────────────────────────
mlmodel/catboost_info/
mlmodel/models/
mlmodel/layer*/
# The two files the running service loads (app/categorization/ml_service.py)
# MUST be committed: Render builds the image from git, and without them every
# B2B response degrades to rules-only with a CLASSIFIER_DEGRADED warning.
# `artifacts/*` (not `artifacts/`) so the re-includes below can take effect.
mlmodel/artifacts/*
!mlmodel/artifacts/categorizer_model.joblib
!mlmodel/artifacts/model_metadata.json
mlmodel/artifacts_backup*/
mlmodel/models_existing_eval/
mlmodel/models_newsheet_eval/
mlmodel/__pycache__/
mlmodel/.pytest_cache/
mlmodel/predictions_data.js
# Removed from the repo: it was unused by any code and carried a
# production hostname and password-shaped fields. Kept ignored so a
# local copy can never be committed again. Real DB config comes from
# DATABASE_URL in the environment.
mlmodel/config.json

# ─── PDF / documents uploaded during dev ─────────────────────────────────────
*.pdf
# Synthetic test statements used by tests/test_statement_closing_balance.py.
!fixtures/*.pdf

# ─── Compiled / packaged executables ─────────────────────────────────────────
dist/
*.exe
*.spec

# ─── Test cache ───────────────────────────────────────────────────────────────
.pytest_cache/

